#!/bin/bash
# ~/.bin/sway-status
#
# Plain i3bar text-protocol status line for swaybar's `status_command` (see
# `bar {}` in ~/.config/sway/config). Mirrors the companion dwm config's
# slstatus setup (../dwm/.slstatus/config.h) -- same segments in the same
# order, same 1s poll interval, same two-space inter-segment separator --
# but as one combined script (this repo's one-script-per-tool convention,
# e.g. sway-masterstack) instead of dwm's split bat-status/net-status/
# vol-status files, and with plain text labels (BAT/BRI/VOL/NET) instead of
# slstatus's Font Awesome glyphs -- no nerdfonts anywhere in this repo.
#
# Segment order: focused window title, layout indicator, BAT, BRI, VOL, NET,
# clock. The first two stand in for waybar's old sway/window module and
# custom/layout module -- native swaybar has no equivalent slots, so both move
# into the status line itself.
#
# Immediate refresh on layout-mode change / workspace focus change is driven
# by sway-masterstack's signal_status() writing a line to a FIFO, which the
# main loop below blocks on (with a 1s timeout) instead of a plain `sleep`.
# This intentionally avoids OS signals: delivering a signal (e.g. SIGUSR1)
# into a running bash script can interrupt bash's own read() of its script
# source mid-reparse of a compound command (this script's own `while` loop),
# corrupting the parse and killing the whole process -- confirmed live,
# reproducible on demand by sending a quick burst of signals (e.g. from
# rapidly switching workspaces a few times in a row).

set -u

MASTERSTACK="$HOME/.bin/sway-masterstack"
FIFO="${XDG_RUNTIME_DIR:-/tmp}/sway-status.fifo"
[ -p "$FIFO" ] || mkfifo "$FIFO"
# Read-write open: never blocks (unlike a write-only open of a FIFO with no
# reader yet), and keeps a permanent reader end alive so signal_status()'s
# writes never block either.
exec 3<>"$FIFO"

battery() {
    local bat p s
    for bat in /sys/class/power_supply/BAT*; do
        [ -d "$bat" ] || continue
        p=$(cat "$bat/capacity" 2>/dev/null) || continue
        s=$(cat "$bat/status" 2>/dev/null)
        if [ "$s" = "Charging" ]; then
            printf 'BAT %s%%+' "$p"
        else
            printf 'BAT %s%%' "$p"
        fi
        return
    done
}

brightness() {
    local b
    b=$(brightnessctl -m 2>/dev/null | cut -d, -f4)
    [ -n "$b" ] && printf 'BRI %s' "$b"
}

volume() {
    local out
    out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    [ -z "$out" ] && return
    if printf '%s' "$out" | grep -q MUTED; then
        printf 'VOL muted'
    else
        printf 'VOL %s%%' "$(printf '%s' "$out" | LC_ALL=C awk '{printf "%d", $2 * 100}')"
    fi
}

net() {
    local wl ssid eth
    wl=$(ls /sys/class/net/ 2>/dev/null | grep -E '^wl' | head -1)
    if [ -n "$wl" ]; then
        ssid=$(iw dev "$wl" link 2>/dev/null | awk '/SSID:/{sub(/.*SSID: /, ""); print}')
        if [ -n "$ssid" ]; then
            printf 'NET %s' "$ssid"
            return
        fi
    fi
    # No associated wifi (or no wifi adapter) -- fall back to a wired route
    # before giving up, instead of reporting down while ethernet is up.
    eth=$(ip route show default 2>/dev/null | awk 'NR==1{print $5}')
    if [ -n "$eth" ]; then
        printf 'NET eth'
    else
        printf 'NET down'
    fi
}

print_status() {
    local seg out=""
    for seg in \
        "$("$MASTERSTACK" title 2>/dev/null)" \
        "$("$MASTERSTACK" status 2>/dev/null)" \
        "$(battery)" \
        "$(brightness)" \
        "$(volume)" \
        "$(net)" \
        "$(date '+%Y-%m-%d %H:%M')"
    do
        [ -z "$seg" ] && continue
        out="${out:+$out  }$seg"
    done
    printf '%s\n' "$out"
}

while true; do
    print_status
    read -t 1 -r _ <&3
done
