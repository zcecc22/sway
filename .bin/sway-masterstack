#!/usr/bin/env python3
"""dwm-style master/stack tiling for Sway, via i3ipc.

    sway-masterstack            daemon: auto-arrange on window new/close/
                                 float/move, and re-signal sway-status on
                                 workspace focus change
    sway-masterstack cycle      Mod+Tab: promote bottom-of-stack into master
                                 (or swap the visible window, in monocle mode)
    sway-masterstack monocle    Mod+m: toggle monocle on the focused
                                 workspace
    sway-masterstack tile       Mod+t: return the focused workspace to
                                 master-stack mode
    sway-masterstack status     print "[M]" or "[]=" for the focused
                                 workspace, for sway-status's layout segment
    sway-masterstack title      print the focused window's title, or "" if
                                 none, for sway-status's title segment

Mirrors the companion dwm config's nmaster=1 and dwm's custom
cyclemaster()/pop() (Mod+Tab promotes the bottom of the stack into master).
mfact=0.55 is sized so both master and stack columns clear an 80-col
terminal, while still giving master the wider half.
Monocle has no native Sway equivalent (Sway's tabbed/stacking layouts always
draw a tab strip; dwm's monocle has none) so it's built on the scratchpad:
only the active window sits on the workspace, the rest are parked hidden.
"""
import os
import re
import sys
import time

from i3ipc import Connection, Event

STATUS_FIFO = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "sway-status.fifo"
)

MFACT = 0.55  # gives master the wider share while keeping both master and
              # stack columns above 80 cols on the panel's full width.
              # nmaster is fixed at 1 -- the dwm build this mirrors has no
              # incnmaster binding, so master is always a single leaf, never
              # a wrapper of several.

MARK_MASTER_PREFIX = "_ms_master_"
MARK_STACK_PREFIX = "_ms_stack_"    # tops the stack, within a workspace
MONO_ACTIVE_PREFIX = "_ms_mono_active_"
MONO_PARKED_PREFIX = "_ms_mono_parked_"

def signal_status():
    # Wakes sway-status's main loop early via a FIFO write rather than a
    # signal: delivering a signal (e.g. SIGUSR1) into a running bash script
    # can interrupt bash's own read() of its script source mid-reparse of a
    # compound command (sway-status's own `while` loop), corrupting the
    # parse and killing the whole process -- confirmed live, reliably
    # reproducible from a quick burst of signals (e.g. rapidly switching
    # workspaces a few times in a row). A FIFO write carries no such risk.
    #
    # Non-blocking open: best-effort, matching the old pkill's silent
    # no-op when sway-status isn't running (e.g. this fires during a
    # `sway-masterstack tile` invocation from a terminal, not the live
    # session). With no reader present, O_NONBLOCK makes the open fail
    # immediately (ENXIO) instead of hanging the daemon's event loop.
    try:
        fd = os.open(STATUS_FIFO, os.O_WRONLY | os.O_NONBLOCK)
        try:
            os.write(fd, b"\n")
        finally:
            os.close(fd)
    except OSError:
        pass


def mark_master(ws_name):
    # Marks are unique tree-wide in sway (see mono_parked_mark below) --
    # confirmed live, a bare "_ms_master" mark gets stolen by whichever
    # workspace most recently created a window, silently wiping every
    # OTHER workspace's master/stack bookkeeping the moment a second
    # workspace gets windows. Namespaced by workspace so each one owns its
    # own master/stack marks independently.
    return f"{MARK_MASTER_PREFIX}{ws_name}"


def mark_stack(ws_name):
    return f"{MARK_STACK_PREFIX}{ws_name}"


def mark_mono_active(ws_name):
    return f"{MONO_ACTIVE_PREFIX}{ws_name}"


def mono_parked_mark(ws_name, con_id):
    # Marks are unique tree-wide in sway: adding the same mark string to a
    # second container silently steals it from whichever container held it
    # before (confirmed live -- with one shared mark per workspace, only
    # the LAST window parked for monocle ever kept it; every earlier one
    # was left unmarked and unrecoverable). Each parked window gets its
    # own mark, keyed by con_id, so this can't happen.
    return f"{MONO_PARKED_PREFIX}{ws_name}_{con_id}"


def mono_parked_pattern(ws_name):
    return re.compile(rf"^{re.escape(MONO_PARKED_PREFIX)}{re.escape(ws_name)}_\d+$")


def find_one(con, mark):
    # Anchored + escaped: i3ipc's find_marked does an unanchored regex
    # search, so an un-anchored "_ms_master_1" would also match
    # "_ms_master_10" once workspace names get into double digits.
    matches = con.find_marked(f"^{re.escape(mark)}$")
    return matches[0] if matches else None


def tiled_leaves(ws):
    # ws.leaves() includes floating windows (i3ipc's Con.__iter__ walks
    # floating_nodes at every level too) -- confirmed against the
    # installed i3ipc source. Callers that mean "the tiled windows on this
    # workspace" need this instead, matching what on_window_new already
    # checks manually via ws.floating_nodes.
    floating_ids = {n.id for f in ws.floating_nodes for n in [f, *f.leaves()]}
    return [c for c in ws.leaves() if c.id not in floating_ids]


def settle(i3, ws_id, predicate, tries=20, pause=0.01):
    """Poll until predicate(ws) holds, or give up and return the last read.

    Added while chasing a monocle-exit corruption that turned out to be a
    two-writer race with the daemon (see exit_monocle's parked-mark
    handling) rather than sway deferring its own tree commit -- that
    "deferred reflow" theory was the working hypothesis at the time but
    was never independently confirmed, and the data pointed away from it
    (poll-until-condition scored worse than a plain sleep, which a stale
    read alone can't explain). Retained as cheap belt-and-braces around
    the individual command sequences in promote_to_master; the real fix
    for the corruption is in exit_monocle."""
    ws = i3.get_tree().find_by_id(ws_id)
    for _ in range(tries):
        if ws is not None and predicate(ws):
            return ws
        time.sleep(pause)
        ws = i3.get_tree().find_by_id(ws_id)
    return ws


def get_master(ws):
    return find_one(ws, mark_master(ws.name))


def get_stack_wrapper(ws):
    top = find_one(ws, mark_stack(ws.name))
    if top is None or top.parent is None or top.parent.id == ws.id:
        # A MARK_STACK leaf sitting directly under the workspace (no real
        # nested wrapper) has top.parent == ws -- confirmed live, right
        # after exit_monocle's scratchpad restore, every window lands as a
        # flat workspace child (move to workspace never nests), so this
        # was misread as "wrapper exists" and skipped ever creating one.
        return None
    return top.parent


def ws_by_name_or_focused(i3, name=None):
    tree = i3.get_tree()
    if name:
        return next((w for w in tree.workspaces() if w.name == name), None)
    focused = tree.find_focused()
    return focused.workspace() if focused else None


def reassert_ratio(i3, ws_id):
    ws = i3.get_tree().find_by_id(ws_id)
    if ws is None:
        return
    master = get_master(ws)
    if master and get_stack_wrapper(ws):
        i3.command(f'[con_id={master.id}] resize set width {int(MFACT * 100)} ppt')


def promote_to_master(i3, ws_id, target_id):
    """Make target_id master, demoting the current master (if any) to the
    top of the stack. Covers 0->1, 1->2, and N->N transitions; also used
    directly by `cycle` (target = bottom of stack)."""
    ws = i3.get_tree().find_by_id(ws_id)
    ws_name = ws.name
    master = get_master(ws)

    if master is None:
        i3.command(f'[con_id={target_id}] mark --add {mark_master(ws_name)}')
        i3.command(f'[con_id={target_id}] resize set width 100 ppt')
        i3.command(f'[con_id={target_id}] focus')
        return

    if target_id == master.id:
        i3.command(f'[con_id={target_id}] focus')
        return

    # Normalize: pull target out to a direct child of the workspace,
    # regardless of where it currently lives (brand new window, or buried
    # in the stack for a `cycle`). Target ws_name explicitly rather than
    # "workspace current" -- confirmed live that "current" means whichever
    # workspace has global focus, not necessarily ws_id, and the two can
    # differ (e.g. multi-output setups, or focus lagging an event).
    master_id_before = master.id
    i3.command(f'[con_id={target_id}] move to workspace {ws_name}')

    # See settle(): waits for both target and the pre-move master to be
    # back in a consistent, findable state before reading master off of it.
    ws = settle(
        i3, ws_id,
        lambda w: w.find_by_id(target_id) is not None
        and w.find_by_id(master_id_before) is not None
        and mark_master(ws_name) in w.find_by_id(master_id_before).marks,
    )
    master = find_one(ws, mark_master(ws_name))
    wrapper = get_stack_wrapper(ws)

    if wrapper is None:
        # 1 -> 2: wrap the old master so it has somewhere to receive
        # siblings, which also makes it the new stack column.
        old_master_id = master.id
        i3.command(f'[con_id={old_master_id}] split vertical')
        # See settle(): wait for master's parent to genuinely no longer be
        # ws before trusting the reread.
        ws = settle(
            i3, ws_id,
            lambda w: (n := w.find_by_id(old_master_id)) is not None
            and n.parent is not None and n.parent.id != w.id,
        )
        master = ws.find_by_id(old_master_id)
        # MARK_STACK belongs on the top-of-stack LEAF (get_stack_wrapper
        # derives the wrapper as leaf.parent), not on the wrapper itself --
        # matches how the N->N branch below re-tags it (line ~109).
        i3.command(f'[con_id={master.id}] mark --add {mark_stack(ws_name)}')
    else:
        top = find_one(ws, mark_stack(ws_name))
        demoted_id = master.id
        i3.command(f'[con_id={demoted_id}] move to mark {mark_stack(ws_name)}')
        # See settle(): wait for the demoted master to genuinely land
        # inside a wrapper (parent != ws) before reading back. Also
        # re-derive the wrapper fresh via the (still-marked) stack-top
        # leaf rather than reusing the pre-move wrapper con_id: confirmed
        # live that "move to mark" can invalidate/recreate the wrapper
        # container when it pulls in a container from elsewhere in the
        # tree (e.g. exit_monocle re-promoting several windows in a row),
        # leaving the old id lookup return None and crash here.
        ws = settle(
            i3, ws_id,
            lambda w: (n := w.find_by_id(demoted_id)) is not None
            and n.parent is not None and n.parent.id != w.id,
        )
        master = ws.find_by_id(demoted_id)
        wrapper2 = get_stack_wrapper(ws)
        if wrapper2 is not None and wrapper2.nodes and wrapper2.nodes[0].id != master.id:
            i3.command(f'[con_id={master.id}] move up')
        i3.command(f'[con_id={top.id}] unmark {mark_stack(ws_name)}')
        i3.command(f'[con_id={master.id}] mark --add {mark_stack(ws_name)}')

    i3.command(f'[con_id={master.id}] unmark {mark_master(ws_name)}')
    i3.command(f'[con_id={target_id}] mark --add {mark_master(ws_name)}')

    # dwm always draws master on the left; make sure the workspace's two
    # top-level children ended up in that order. See settle(): wait for
    # the mark-add above to be visible before reading tree shape off of it.
    ws = settle(
        i3, ws_id,
        lambda w: (n := w.find_by_id(target_id)) is not None
        and mark_master(ws_name) in n.marks,
    )
    if ws.nodes and not any(c.id == target_id for c in ws.nodes):
        # target_id can still be nested here -- e.g. exit_monocle's final
        # re-promotion of the original pre-monocle master, which never
        # left the wrapper through its rebuild loop above. Confirmed live:
        # in that shape, ws.nodes[0] (the swap fallback below) IS the very
        # wrapper target_id is nested in, so swapping against it swaps
        # target with its own ancestor -- a degenerate, self-referential
        # op that corrupts the tree (produces deep, wrongly-split nesting)
        # instead of a clean pop-out. "move left" reliably pops a nested
        # leaf out of the stack wrapper (always splitv, so there's no
        # horizontal sibling to reorder among instead -- same fix used in
        # fixup_workspace's master-recovery path) -- do that first so the
        # swap below (if still needed) operates on a genuine sibling.
        i3.command(f'[con_id={target_id}] move left')
        ws = settle(i3, ws_id, lambda w: any(c.id == target_id for c in w.nodes))
    # `move left` is otherwise unsafe as the general reorder mechanism:
    # when target_id is ALREADY a top-level sibling adjacent to the stack
    # wrapper, sway can descend it into that container instead of
    # reordering it at the workspace level -- confirmed live, it absorbs
    # the new master into the stack. `swap container` exchanges tree
    # position without that directional-adjacency fallback, and is safe
    # here since target_id is now guaranteed to be a genuine sibling of
    # `other`, never its own ancestor.
    if ws.nodes and ws.nodes[0].id != target_id:
        other = ws.nodes[0]
        i3.command(f'[con_id={target_id}] swap container with con_id {other.id}')

    i3.command(f'[con_id={target_id}] resize set width {int(MFACT * 100)} ppt')
    i3.command(f'[con_id={target_id}] focus')


def fixup_workspace(i3, ws):
    """Re-establish the master/stack invariant after a close or an
    unfloat, without knowing exactly what just changed."""
    ws = i3.get_tree().find_by_id(ws.id)
    ws_name = ws.name
    if find_one(ws, mark_mono_active(ws_name)) is not None:
        return  # monocle bookkeeping is separate, see fixup during monocle
    tiled = tiled_leaves(ws)
    if not tiled:
        return
    master = get_master(ws)
    if master is None:
        stack_top = find_one(ws, mark_stack(ws_name))
        candidate = stack_top if stack_top is not None else tiled[0]
        if stack_top is not None:
            i3.command(f'[con_id={candidate.id}] unmark {mark_stack(ws_name)}')
            # Pop candidate out of the (always-splitv) stack wrapper to
            # become its own top-level workspace child. "move to
            # workspace" is a no-op here -- confirmed live, candidate can
            # stay nested inside the wrapper even after it "succeeds".
            # "move left" is safe in this specific direction here because
            # a splitv wrapper has no horizontal siblings to reorder among,
            # so sway pops the container out instead -- the opposite risk
            # from promote_to_master's reordering step, where the target is
            # already top-level and "move left" can instead descend INTO
            # an adjacent wrapper (that's why swap container is used
            # there).
            i3.command(f'[con_id={candidate.id}] move left')
        i3.command(f'[con_id={candidate.id}] mark --add {mark_master(ws_name)}')
        master = candidate

    # A close can leave no leaf carrying MARK_STACK -- either the marked
    # top-of-stack window closed directly, or it just got promoted to
    # master above -- even though a real stack wrapper with content still
    # exists. Re-tag its current top so get_stack_wrapper() (and the
    # resize below, which depends on it) keep working instead of silently
    # reporting "no stack" until the next new window.
    ws = i3.get_tree().find_by_id(ws.id)
    if find_one(ws, mark_stack(ws_name)) is None:
        wrapper = next(
            (c for c in ws.nodes if c.id != master.id and c.nodes), None
        )
        if wrapper is not None and wrapper.nodes:
            i3.command(
                f'[con_id={wrapper.nodes[0].id}] mark --add {mark_stack(ws_name)}'
            )

    if len(tiled) == 1:
        i3.command(f'[con_id={master.id}] resize set width 100 ppt')
    else:
        reassert_ratio(i3, ws.id)


def tile_cycle(i3):
    ws = ws_by_name_or_focused(i3)
    if ws is None:
        return
    wrapper = get_stack_wrapper(ws)
    if wrapper is None or not wrapper.nodes:
        return  # fewer than 2 tiled windows: matches dwm's cyclemaster guard
    bottom = wrapper.nodes[-1]
    promote_to_master(i3, ws.id, bottom.id)


def enter_monocle(i3):
    ws = ws_by_name_or_focused(i3)
    if ws is None or find_one(ws, mark_mono_active(ws.name)) is not None:
        return
    tiled = tiled_leaves(ws)
    if not tiled:
        return  # nothing to monoclize
    # dwm's monocle applies with any window count >= 1 (not just >= 2, the
    # threshold before this fix) -- a single tiled window is already
    # full-width/height, so a lone window just gets marked active (for the
    # bar, and so a later new window parks correctly) without visibly
    # moving anything.
    focused = i3.get_tree().find_focused()
    tiled_ids = [c.id for c in tiled]
    active = focused if focused.id in tiled_ids else tiled[0]
    for c in tiled:
        if c.id == active.id:
            continue
        i3.command(f'[con_id={c.id}] mark --add {mono_parked_mark(ws.name, c.id)}')
        i3.command(f'[con_id={c.id}] move to scratchpad')
    i3.command(f'[con_id={active.id}] mark --add {mark_mono_active(ws.name)}')
    i3.command(f'[con_id={active.id}] resize set width 100 ppt')
    i3.command(f'[con_id={active.id}] resize set height 100 ppt')
    i3.command(f'[con_id={active.id}] focus')
    signal_status()


def exit_monocle(i3):
    ws = ws_by_name_or_focused(i3)
    if ws is None:
        return
    ws_name = ws.name
    active = find_one(ws, mark_mono_active(ws_name))
    parked = i3.get_tree().find_marked(mono_parked_pattern(ws_name))
    if active is None and not parked:
        # Not in monocle. Note: active alone can be None while parked
        # windows still exist -- e.g. the active monocle window was
        # closed, which drops its mark along with it but leaves every
        # parked window stranded in the scratchpad. Checking parked here
        # too is what lets this restore them instead of silently no-oping.
        return
    # The rebuild loop below ends by promoting the pre-monocle master, which
    # focuses it as a side effect -- capture what was actually
    # visible/focused going in so it can be restored as the final focus
    # instead of always jumping back to master.
    pre_focused = i3.get_tree().find_focused()
    pre_focused_id = pre_focused.id if pre_focused is not None else None
    if active is not None:
        i3.command(f'[con_id={active.id}] unmark {mark_mono_active(ws_name)}')

    for c in parked:
        # Give the container a real tiling context before asking it to
        # stop floating -- it has none while still hidden in the scratchpad.
        i3.command(f'[con_id={c.id}] move to workspace {ws_name}')
        i3.command(f'[con_id={c.id}] floating disable')
        # Deliberately do NOT unmark the parked mark here. The daemon is a
        # SEPARATE process/connection subscribed to WINDOW_FLOATING, and
        # each "floating disable" above fires it an event; its guard reads
        # marks at EVENT-PROCESSING time, not emission time. Confirmed
        # live: unmarking here (even after floating disable) left a window
        # where the daemon could drain that event after the unmark lands,
        # miss the "monocle owns this" guard, and call promote_to_master()
        # on this same workspace concurrently with the rebuild loop below
        # -- two writers, nondeterministic interleaving, corrupted tree.
        # 20/20 clean with the daemon stopped entirely proved it wasn't a
        # timing/reflow issue in this process. Every parked window now
        # keeps its mark for the whole restore+rebuild below; they're all
        # unmarked together at the very end, once nothing here can still
        # trigger that event race.
        settle(i3, ws.id, lambda w, cid=c.id: any(leaf.id == cid for leaf in w.leaves()))

    # Rebuild master/stack from the _ms_master/_ms_stack marks every
    # window already carries (untouched while parked). Best-effort: exact
    # stack ORDER from before monocle isn't guaranteed to survive, only
    # that the same set of windows ends up master + stack. LIVE-VERIFY.
    #
    # The parked marks are dropped in `finally`, not inline, so they still
    # come off if anything in here raises -- otherwise a mid-rebuild
    # exception would leave them on permanently, which would also permanently
    # exempt those windows from on_window_floating's normal handling (its
    # guard treats a parked mark as "monocle owns this transition").
    try:
        tree = i3.get_tree()
        ws = next((w for w in tree.workspaces() if w.name == ws_name), None)
        if ws is None:
            return
        master = get_master(ws)
        # Scoped to ws and to leaves only, as defense in depth: marks are
        # now workspace-namespaced so cross-workspace leakage can't
        # happen, but a stray non-leaf mark (e.g. from a future bug) would
        # still get treated as if it were a real window without the leaf
        # filter.
        others = [
            c for c in ws.find_marked(mark_stack(ws_name))
            if not c.nodes and c.id != (master.id if master else None)
        ]
        others += [c for c in tiled_leaves(ws) if master is None or c.id != master.id]
        seen = set()
        ordered = []
        for c in others:
            if c.id not in seen:
                seen.add(c.id)
                ordered.append(c)

        if master is None:
            fixup_workspace(i3, ws)
        else:
            i3.command(f'[con_id={master.id}] resize set width 100 ppt')
            for c in ordered:
                promote_to_master(i3, ws.id, c.id)
            promote_to_master(i3, ws.id, master.id)
        if pre_focused_id is not None:
            i3.command(f'[con_id={pre_focused_id}] focus')
    finally:
        for c in parked:
            i3.command(f'[con_id={c.id}] unmark {mono_parked_mark(ws_name, c.id)}')
    signal_status()


def monocle_cycle(i3):
    """Returns True if the focused workspace was in monocle mode (and the
    swap, or no-op, has been handled); False to fall through to tile_cycle."""
    ws = ws_by_name_or_focused(i3)
    if ws is None:
        return False
    ws_name = ws.name
    active = find_one(ws, mark_mono_active(ws_name))
    if active is None:
        return False
    parked = i3.get_tree().find_marked(mono_parked_pattern(ws_name))
    if not parked:
        return True  # only one window in the monocle set
    nxt = parked[0]
    i3.command(f'[con_id={active.id}] unmark {mark_mono_active(ws_name)}')
    i3.command(f'[con_id={active.id}] mark --add {mono_parked_mark(ws_name, active.id)}')
    i3.command(f'[con_id={active.id}] move to scratchpad')
    i3.command(f'[con_id={nxt.id}] unmark {mono_parked_mark(ws_name, nxt.id)}')
    i3.command(f'[con_id={nxt.id}] mark --add {mark_mono_active(ws_name)}')
    i3.command(f'[con_id={nxt.id}] move to workspace {ws_name}')
    i3.command(f'[con_id={nxt.id}] floating disable')
    i3.command(f'[con_id={nxt.id}] resize set width 100 ppt')
    i3.command(f'[con_id={nxt.id}] resize set height 100 ppt')
    i3.command(f'[con_id={nxt.id}] focus')
    return True


def run_cycle():
    i3 = Connection()
    if monocle_cycle(i3):
        return
    tile_cycle(i3)


def on_window_new(i3, event):
    tree = i3.get_tree()
    node = tree.find_by_id(event.container.id)
    if node is None:
        return
    ws = node.workspace()
    if ws is None or node.id in [f.id for f in ws.floating_nodes]:
        return

    mono_active = find_one(ws, mark_mono_active(ws.name))
    if mono_active is not None:
        i3.command(f'[con_id={mono_active.id}] unmark {mark_mono_active(ws.name)}')
        i3.command(
            f'[con_id={mono_active.id}] mark --add '
            f'{mono_parked_mark(ws.name, mono_active.id)}'
        )
        i3.command(f'[con_id={mono_active.id}] move to scratchpad')
        i3.command(f'[con_id={node.id}] mark --add {mark_mono_active(ws.name)}')
        i3.command(f'[con_id={node.id}] resize set width 100 ppt')
        i3.command(f'[con_id={node.id}] resize set height 100 ppt')
        # Still needs master/stack bookkeeping so a later Mod+t rebuilds
        # correctly, exactly as if this had arrived in tile mode.
        promote_to_master(i3, ws.id, node.id)
        return

    promote_to_master(i3, ws.id, node.id)


def on_window_close(i3, event):
    # The closed container's ancestry is gone by the time we can query the
    # tree, so we can't look up its old workspace directly. Sway refocuses
    # another window on the same workspace right after a close (unless it
    # was that workspace's last window, in which case there's nothing left
    # there to fix up anyway) -- the focused workspace is a reliable
    # enough proxy. LIVE-VERIFY if this proves flaky in practice.
    tree = i3.get_tree()
    focused = tree.find_focused()
    if focused is None:
        return
    ws = focused.workspace()
    if ws is None:
        return
    if (
        find_one(ws, mark_mono_active(ws.name)) is None
        and tree.find_marked(mono_parked_pattern(ws.name))
    ):
        # The window that just closed was monocle's own active window: its
        # _ms_mono_active_ mark died with it, so fixup_workspace's monocle
        # guard (which only checks for that mark) can't see it, and
        # tiled_leaves(ws) reads empty since every other window is still
        # hidden in the scratchpad -- fixup_workspace would silently no-op
        # and leave the workspace blank. exit_monocle already treats
        # "active gone, parked windows remain" as its restore case, so hand
        # off to it instead. Note: if a PARKED (non-active) window closed
        # instead, mark_mono_active is still present here, so this correctly
        # falls through to fixup_workspace below, whose own monocle guard
        # already no-ops -- exactly what happened before this check existed.
        exit_monocle(i3)
        return
    fixup_workspace(i3, ws)


def on_window_floating(i3, event):
    tree = i3.get_tree()
    node = tree.find_by_id(event.container.id)
    if node is None:
        return
    is_floating = any(
        node.id == f.id for w in tree.workspaces() for f in w.floating_nodes
    )
    if any(m.startswith(MONO_PARKED_PREFIX) for m in node.marks):
        # This float transition (either direction) is monocle's own doing:
        # entering/cycling marks a window PARKED then moves it to the
        # scratchpad; exiting moves it back then disables floating -- in
        # both cases the mark is already in place before the float change,
        # unlike the ACTIVE case below. Confirmed live, reacting here races
        # monocle's own bookkeeping (marks get stripped moments after being
        # set, or the window gets re-promoted concurrently with
        # exit_monocle's own rebuild loop). Leave monocle's own code fully
        # in charge of these windows.
        return
    active_mark = next(
        (m for m in node.marks if m.startswith(MONO_ACTIVE_PREFIX)), None
    )
    if active_mark is not None:
        if not is_floating:
            # Monocle's own transitions never leave the active window
            # floating (enter/cycle re-mark it PARKED before floating it;
            # exit never floats it at all) -- this fired for some other
            # reason but the window is already back to non-floating,
            # nothing to react to.
            return
        # The only way an ACTIVE-marked window ends up floating is a direct
        # Mod+f on it -- sway's native `floating toggle`, entirely outside
        # the daemon/CLI's own commands, which never produce this
        # mark+floating combination. Exit monocle so the rest of the
        # parked set returns to tiling instead of staying stranded in the
        # scratchpad under a now-stale invariant; the window that was just
        # floated is left alone, since floating it is what was just asked
        # for.
        i3.command(f'[con_id={node.id}] unmark {active_mark}')
        exit_monocle(i3)
        return
    if not is_floating:
        # Became tiled again (e.g. a manual floating toggle back to
        # tiled). NOT covered by window::new -- that only fires for
        # windows that didn't exist before, not for an existing window
        # changing float state (confirmed live: nothing else reflows this,
        # leaving it a flat top-level sibling with no marks and wrong
        # proportions). Treat it like a newly arrived tiled window.
        ws = node.workspace()
        if ws is not None:
            promote_to_master(i3, ws.id, node.id)
        return
    for mark in list(node.marks):
        if mark.startswith("_ms_"):
            i3.command(f'[con_id={node.id}] unmark {mark}')
    ws = node.workspace()
    if ws is not None:
        fixup_workspace(i3, ws)


def on_window_move(i3, event):
    # Fires for Mod+Shift+<N> (move to workspace), but ALSO for every
    # daemon- or CLI-issued "move to workspace"/"move to mark"/"move left"
    # inside promote_to_master and fixup_workspace, since those are
    # genuinely the same sway command -- the two cases can't be told apart
    # by which command ran, only by the container's state.
    #
    # Events on THIS daemon's own connection queue and dispatch only after
    # whichever handler triggered them has already returned, so a move
    # self-triggered by on_window_new/on_window_floating is safe to reason
    # about as "already fully settled." But `cycle`/`monocle`/`tile` run as
    # SEPARATE short-lived processes (see the on_window_floating comment on
    # exit_monocle for the same cross-process race), so a move they issue
    # can be observed by this daemon mid-flight, e.g. `cycle`'s
    # promote_to_master between its "move to workspace" (line ~185, no
    # marks yet) and the mark --add many commands later. A intra-workspace
    # daemon/CLI move is therefore NOT reliably distinguishable by "does it
    # already carry dest's fresh mark" alone -- it may carry no _ms_ mark
    # at all when this fires.
    #
    # What's actually true for every intra-workspace daemon/CLI move,
    # regardless of race timing, is that the container never leaves its
    # workspace: dest == src, and any _ms_ mark it carries (if any) already
    # names THIS workspace, never a different one. A genuine cross-
    # workspace user move breaks exactly one of those: either focus is
    # still on a different (source) workspace, or the container carries a
    # stale mark naming the workspace it used to be master/stack-top on
    # (the "focus already followed the move" edge case -- e.g. moving the
    # LAST window off a workspace, which is always that workspace's
    # master).
    tree = i3.get_tree()
    node = tree.find_by_id(event.container.id)
    if node is None:
        return
    if any(
        m.startswith(MONO_ACTIVE_PREFIX) or m.startswith(MONO_PARKED_PREFIX)
        for m in node.marks
    ):
        return  # monocle's own scratchpad shuffling also fires window::move
    dest = node.workspace()
    if dest is None:
        return
    if node.id in [f.id for f in dest.floating_nodes]:
        return
    dest_name = dest.name
    focused = tree.find_focused()
    src = focused.workspace() if focused is not None else None
    cross_workspace = src is not None and src.id != dest.id
    stale_mark = any(
        (m.startswith(MARK_MASTER_PREFIX) or m.startswith(MARK_STACK_PREFIX))
        and m not in (mark_master(dest_name), mark_stack(dest_name))
        for m in node.marks
    )
    if not cross_workspace and not stale_mark:
        return  # intra-workspace daemon/CLI move -- not a genuine user move
    if cross_workspace:
        fixup_workspace(i3, src)
    for mark in list(node.marks):
        if mark.startswith("_ms_"):
            i3.command(f'[con_id={node.id}] unmark {mark}')
    promote_to_master(i3, dest.id, node.id)


def print_status(i3):
    """Print the focused workspace's current mode, for sway-status's layout
    segment: `[M]` in monocle (dwm parity), `[]=` in master-stack."""
    ws = ws_by_name_or_focused(i3)
    if ws is not None and find_one(ws, mark_mono_active(ws.name)) is not None:
        print("[M]")
    else:
        print("[]=")


def print_title(i3):
    """Print the focused window's title for sway-status's title segment.
    Prints an empty line when there's no focused *window* -- e.g. an empty
    workspace, where find_focused() returns the workspace container itself
    (not a window), whose .name is the workspace's own name/number rather
    than a title. Checking .window/.app_id (only set on real window
    containers, X11/Wayland respectively) distinguishes that case.
    LIVE-VERIFY against an actual empty-workspace focus."""
    focused = i3.get_tree().find_focused()
    if focused is not None and (focused.window or focused.app_id):
        print(focused.name or "")
    else:
        print("")


def run_daemon():
    i3 = Connection()

    def guarded(fn):
        def _handler(i3conn, event):
            try:
                fn(i3conn, event)
            except Exception as exc:  # keep the daemon alive across bad events
                print(f"sway-masterstack: {exc}", file=sys.stderr)

        return _handler

    i3.on(Event.WINDOW_NEW, guarded(on_window_new))
    i3.on(Event.WINDOW_CLOSE, guarded(on_window_close))
    i3.on(Event.WINDOW_FLOATING, guarded(on_window_floating))
    i3.on(Event.WINDOW_MOVE, guarded(on_window_move))
    # Not a tiling-invariant concern -- print_status reports the FOCUSED
    # workspace's mode, so switching workspaces (Mod+1-9, native sway
    # command, no daemon involvement otherwise) can change what the bar
    # should show even though no mark anywhere changed.
    i3.on(Event.WORKSPACE_FOCUS, guarded(lambda i3conn, event: signal_status()))
    i3.main()


def toggle_monocle(i3):
    ws = ws_by_name_or_focused(i3)
    if ws is not None and find_one(ws, mark_mono_active(ws.name)) is not None:
        exit_monocle(i3)
    else:
        enter_monocle(i3)


def main():
    args = sys.argv[1:]
    if not args:
        run_daemon()
    elif args[0] == "cycle":
        run_cycle()
    elif args[0] == "monocle":
        toggle_monocle(Connection())
    elif args[0] == "tile":
        exit_monocle(Connection())
    elif args[0] == "status":
        print_status(Connection())
    elif args[0] == "title":
        print_title(Connection())
    else:
        print(f"usage: {sys.argv[0]} [cycle|monocle|tile|status|title]", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
