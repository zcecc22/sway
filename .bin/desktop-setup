#!/bin/bash
set -e

# Anchor to the repo root regardless of cwd -- etc/udev/rules.d/... below
# is a path relative to this script's own location, not wherever it's
# invoked from.
cd "$(dirname "$(readlink -f "$0")")/.."

sudo apt update

echo "Installing desktop environment..."
sudo apt -y install \
sway \
swaybg \
swayidle \
xwayland \
dbus-bin \
dbus-x11 \
alacritty \
tofi \
waybar \
wl-clipboard \
brightnessctl \
fonts-inconsolata \
fonts-font-awesome \
python3-i3ipc

echo "Installing audio stack..."
sudo apt -y install \
pipewire \
pipewire-pulse \
wireplumber

echo "Granting brightness control to the video group..."
sudo install -m 644 etc/udev/rules.d/90-backlight.rules /etc/udev/rules.d/90-backlight.rules
sudo udevadm control --reload-rules
sudo udevadm trigger --subsystem-match=backlight
sudo usermod -aG video "$USER"
echo "Added $USER to the video group - log out and back in for brightnessctl to work without sudo."

# Sequenced after the (more essential) brightness/video-group setup above,
# and non-fatal: `systemctl --user` needs a user DBus session, which isn't
# guaranteed (e.g. run over SSH) -- a failure here shouldn't skip the
# brightness setup that already succeeded.
echo "Enabling audio services..."
systemctl --user enable --now pipewire pipewire-pulse wireplumber || \
    echo "warning: could not enable audio services now (no user session?) - rerun 'systemctl --user enable --now pipewire pipewire-pulse wireplumber' after logging back in"

echo "Done."
