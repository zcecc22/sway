# ~/.config/sway/config

# Mod key
set $mod Mod4

# Terminal and launcher
set $term alacritty
set $menu tofi-drun

# Wallpaper
output * bg #002b36 solid_color

# HiDPI display scaling. eDP-1 is matched by connector name -- if it ever
# fails silently (renamed/redetected panel), check `swaymsg -t get_outputs`
# and consider matching by "Make Model Serial" instead, which survives
# connector renumbering.
output eDP-1 scale 1.25

# Cursor theme/size, so XWayland and GTK apps don't fall back to an
# undersized cursor at HiDPI scale
seat seat0 xcursor_theme Adwaita 24

# Font
font pango:Inconsolata 20

# Window colors
#                       border  bg      text    indicator child_border
client.focused          #174956 #174956 #93a1a1 #174956   #174956
client.focused_inactive #073642 #002b36 #839496 #073642   #073642
client.unfocused        #073642 #002b36 #839496 #073642   #073642
client.urgent           #dc322f #dc322f #fdf6e3 #dc322f   #dc322f

# Window borders
default_border pixel 4
default_floating_border normal 4

# Floating window move/resize: mod+left-drag to move, mod+right-drag to resize
floating_modifier $mod normal

# Touchpad
input type:touchpad {
    tap enabled
    middle_emulation enabled
}

# Key bindings - basics
bindsym $mod+Return exec $term
bindsym $mod+p exec $menu
bindsym $mod+q kill
bindsym $mod+Shift+q exit
bindsym $mod+Shift+c reload

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

# Move to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# Layout
bindsym $mod+t exec $HOME/.bin/sway-masterstack tile
bindsym $mod+m exec $HOME/.bin/sway-masterstack monocle
bindsym $mod+f floating toggle
bindsym $mod+Tab exec $HOME/.bin/sway-masterstack cycle

# Laptop keys
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Propagate Wayland/X display vars to DBus activation env and systemd user units
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY
exec $HOME/.bin/sway-masterstack

# Idle - blank display after inactivity, matching dwm's `xset dpms 300 600 600`.
# after-resume covers waking from suspend even when the idle timeout never
# fired (resume alone only pairs with a timeout that actually elapsed, so
# without this a suspend-before-300s-idle leaves the display off on wake).
exec swayidle -w \
    timeout 300 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    after-resume 'swaymsg "output * power on"' \
    before-sleep 'swaymsg "output * power off"'

# Status bar
bar {
    position top
    status_command $HOME/.bin/sway-status
    font pango:Inconsolata 20

    colors {
        background          #002b36
        statusline          #93a1a1
        separator           #073642

        focused_background  #002b36
        focused_statusline  #93a1a1
        focused_separator   #073642

        #                    border  bg      text
        focused_workspace    #174956 #174956 #93a1a1
        active_workspace     #073642 #002b36 #839496
        inactive_workspace   #073642 #002b36 #839496
        urgent_workspace     #dc322f #dc322f #fdf6e3
        binding_mode         #dc322f #dc322f #fdf6e3
    }
}
