# ~/.config/tofi/config

font = Inconsolata
font-size = 20

background-color = #002b36
text-color = #839496
prompt-color = #93a1a1
selection-color = #268bd2
input-color = #fdf6e3

border-width = 2
border-color = #073642
outline-width = 0

width = 40%
height = 30%
corner-radius = 0
padding-left = 16
padding-top = 16
result-spacing = 8

prompt-text = "run: "

# Launch the selected entry directly via its desktop file, instead of
# printing to stdout for the sway config to pipe into `swaymsg exec`.
# Also avoids `xargs swaymsg exec --` running with an empty command (and
# logging a spurious error) when Escape is pressed to cancel.
drun-launch = true
